# =============================================================================
#  Configuracion del proyecto TIENDA (multi-tienda idirecto)
#  Copia este fichero a ".env" y ajusta los valores.
#  NO versionar nunca el fichero ".env" (contiene credenciales).
#
#  EN PRODUCCION (ejemplo con el dominio valduran.com, Apache o nginx):
#     APP_ENV=production
#     APP_DEBUG=false
#     APP_URL=http://valduran.com          (https:// cuando haya certificado)
#     BASE_DOMAINS=valduran.com
#     PLATFORM_CNAME=stores.valduran.com
#     PLATFORM_IP=<IP publica del servidor>
#  Al cambiar de dominio basta con tocar APP_URL, BASE_DOMAINS y
#  PLATFORM_CNAME: la aplicacion resuelve la tienda por el Host de la peticion.
# =============================================================================

APP_NAME="Tienda"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Madrid
APP_LOCALE=es

# Clave para cifrado de credenciales (paginas de pago, tokens). 32+ caracteres.
APP_KEY=cambia-esta-clave-por-una-aleatoria-de-32-chars

# -----------------------------------------------------------------------------
# BASE DE DATOS (configurable)
# Es la BD central del mayorista: contiene el catalogo y las tablas de tiendas.
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=idirecto_db
DB_USER=phpmyadmin
DB_PASS=pass
DB_CHARSET=utf8mb4

# -----------------------------------------------------------------------------
# ALMACENAMIENTO DE FICHEROS / IMAGENES (configurable)
#   STORAGE_DRIVER = s3 | local
# Con driver "s3" se sube al bucket del mayorista (requiere el SDK de AWS).
# Con driver "local" los ficheros se guardan en public/uploads (solo desarrollo).
#
# Los dos drivers guardan con la MISMA clave, asi cambiar de driver no invalida
# lo ya guardado en mt_media:
#   {STORAGE_PREFIX}/{STORAGE_FOLDER_PREFIX}_{tipo}/{id}_{tipo}_{fecha}-{aleatorio}.{webp}
#   tenants/tienda_banners/7_banners_20261001-174530-9f3c1a2b.webp
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local

# Prefijo comun dentro del bucket (y de public/uploads). S3_PREFIX se sigue
# aceptando por compatibilidad, pero lo nuevo es STORAGE_PREFIX.
STORAGE_PREFIX=tenants/
# Nombre de la carpeta por tipo de imagen: {prefijo}_{tipo} -> tienda_banners
STORAGE_FOLDER_PREFIX=tienda
# Peso maximo que se acepta subir, en bytes (por defecto 5 MB).
STORAGE_MAX_BYTES=5242880
# ...salvo para los banners, que son fotos grandes de portada: 8 MB.
STORAGE_MAX_BYTES_BANNERS=8388608

# -----------------------------------------------------------------------------
# OPTIMIZACION DE LAS IMAGENES SUBIDAS (GD)
# JPG, PNG, AVIF, BMP y WebP -> WebP comprimido; SVG y GIF animado se respetan.
# -----------------------------------------------------------------------------
IMAGE_OPTIMIZE=true
# Calidad WebP (1-100). 82 es el punto dulce entre peso y calidad visual.
IMAGE_QUALITY=82
# Los banners llevan algo mas de calidad: son degradados grandes y se notan.
IMAGE_QUALITY_BANNERS=86
# Lado maximo en pixeles (si la imagen es mayor se reduce; nunca se amplia).
IMAGE_MAX_WIDTH=2560
IMAGE_MAX_HEIGHT=2560
# Los GIF con animacion se quedan en GIF (a WebP perderian el movimiento).
IMAGE_KEEP_ANIMATED_GIF=true

# -----------------------------------------------------------------------------
# OJO: para admitir banners de 8 MB, PHP tiene que permitirlo. En Apache queda
# ajustado en .htaccess (upload_max_filesize 12M / post_max_size 13M); con
# PHP-FPM (nginx) hay que ponerlo en el pool:
#     upload_max_filesize = 12M
#     post_max_size       = 13M
# y en nginx  client_max_body_size 16M;  (ya viene en deploy/nginx-site.conf.tpl)
# -----------------------------------------------------------------------------

# Ruta alternativa al autoload de Composer que contenga aws/aws-sdk-php.
# Si se deja vacio se busca en ./vendor/autoload.php del propio proyecto.
AWS_SDK_AUTOLOAD=

S3_REGION=eu-west-1
S3_BUCKET=
S3_KEY=
S3_SECRET=
# URL publica base del bucket (opcional). Si se vacia se calcula con el SDK.
S3_PUBLIC_URL=

# -----------------------------------------------------------------------------
# MULTI-TENANT
# -----------------------------------------------------------------------------
# Dominios base de los que se derivan los subdominios de tienda.
# En produccion, por ejemplo:  BASE_DOMAINS=valduran.com
BASE_DOMAINS=local.tienda,tienda.local,idirecto.es,localhost
# Tienda que se muestra si no se puede resolver ninguna (modo demo/pruebas).
DEMO_STORE=idirecto-demo
# IP y host de la plataforma para las instrucciones DNS de dominios propios.
PLATFORM_IP=
PLATFORM_CNAME=stores.idirecto.es

# -----------------------------------------------------------------------------
# CATALOGO CENTRAL
# -----------------------------------------------------------------------------
CATALOG_ENABLED=true
# URL base de las imagenes del catalogo (CDN o dominio del mayorista).
CATALOG_IMAGE_URL=https://idirecto.es/img_products
# Ruta en disco de esas imagenes (opcional; solo para desarrollo local).
CATALOG_IMAGE_PATH=
# Tamano de imagen en los listados: c (3 KB) | l (7 KB) | f (38 KB)
CATALOG_CARD_IMAGE_SIZE=l
# Margen (%) si el producto no tiene precio de tarifa.
CATALOG_MARKUP=30
# Beneficio (%) con el que vende una tienda que no tenga el suyo propio. El
# precio de la web es la TARIFA DE LA TIENDA + este beneficio, con el IVA
# incluido; se cambia por tienda en el panel > Ajustes.
CATALOG_DEFAULT_MARKUP=15
# Productos por pagina en los listados (catalogo, categoria, subcategoria,
# busqueda, filtros). 40 es el valor para todos los dispositivos: las columnas
# son las que se adaptan (CSS), no el numero de productos (evita URLs duplicadas).
CATALOG_PER_PAGE=40
# Resultados del buscador en vivo de la cabecera (desplegable, no pagina).
CATALOG_SEARCH_PER_PAGE=16
# Productos destacados de la portada (seleccion editorial, no paginada).
CATALOG_HOME_FEATURED=12
# Aviso de "ultimas unidades" por debajo de este stock.
CATALOG_LOW_STOCK=5
# TTL (segundos) de las caches de facetas (marcas y rango de precios).
CATALOG_FACETS_TTL=900

# -----------------------------------------------------------------------------
# CACHE DE DATOS (opcional)
# Contadores, arboles de menu, facetas y demas datos caros y estables. El precio
# y el stock NO se cachean: se leen en vivo en cada peticion.
#   CACHE_DRIVER = auto | apcu | file
#     auto -> APCu si la extension esta instalada (recomendado en un solo
#             servidor: memoria compartida, sin ficheros ni red), si no fichero.
#     apcu -> fuerza APCu (si falta la extension, cae a fichero).
#     file -> siempre fichero en storage/cache.
# Requiere la extension php8.4-apcu para el modo APCu.
# -----------------------------------------------------------------------------
CACHE_DRIVER=auto
CACHE_PREFIX=tienda:
# Milisegundos que espera una peticion a que otra termine de calcular una clave.
CACHE_LOCK_WAIT=5000
# Limpieza del driver de fichero: cada cuanto se pasa y que se borra.
CACHE_GC_INTERVAL=300
CACHE_GC_MAX_AGE=172800
CACHE_GC_MAX_FILES=2000

# -----------------------------------------------------------------------------
# SISTEMA DE DISENO (opcional)
# Valores por DEFECTO de la plataforma. Cada tienda los pisa desde su panel
# (Diseno > Identidad visual); aqui solo se cambia el punto de partida.
#   THEME_SCHEME = light | dark | auto  (auto = sigue al sistema operativo)
# -----------------------------------------------------------------------------
THEME_PRIMARY=#e30613
THEME_SECONDARY=#111827
THEME_ACCENT=#00aff0
THEME_SCHEME=light
THEME_BG=#f4f6fa
THEME_SURFACE=#ffffff
THEME_TEXT=#1f2937
THEME_BORDER=#e2e8f0

# -----------------------------------------------------------------------------
# ENVIO DE PEDIDOS AL MAYORISTA (idirecto)
#
# El panel de la tienda lista los pedidos que recibe de sus clientes y permite
# enviar a idirecto solo las lineas que se elijan. El envio ESCRIBE filas reales
# en las tablas `pedidos_addr`, `pedidos` y `pedidos_det` del mayorista, igual
# que su propia web (`web = 1`, `estado = NULL` = activo).
#
# Cada tienda dice con que cuenta compra y con que tarifa en el panel > Ajustes
# (`mt_stores.id_tienda_idirecto` y `mt_stores.id_margen`).
# -----------------------------------------------------------------------------
IDIRECTO_ENABLED=true
# Tarifa (precios.id_margen) usada si la tienda no tiene una asignada.
IDIRECTO_DEFAULT_ID_MARGEN=12
# Reservar stock en el mayorista al enviar (almacenes externos tipo 0 y 4).
# Con false el pedido se crea pero el almacen no reserva nada.
IDIRECTO_RESERVE_STOCK=true
# Comercial y sucursal por defecto si la cuenta de la tienda no trae los suyos.
IDIRECTO_COMERCIAL_ID=10
IDIRECTO_SUCURSAL_ID=1
# Pais de las direcciones creadas en pedidos_addr (ISO-2).
IDIRECTO_COUNTRY_CODE=ES

# -----------------------------------------------------------------------------
# REGISTRO DE TIENDAS (/registro)
#
# En esta web solo puede tener tienda quien ya es cliente del mayorista: el
# tendero entra con el email y la contrasena de su cuenta de idirecto, se
# comprueban contra `tiendas` (activo = 2, ni cerrada ni borrada) y se crea su
# tienda (`mt_stores`) ya enlazada a esa cuenta y con su tarifa, mas su usuario
# de panel. La contrasena de idirecto NO se guarda.
#
# OJO: la contrasena de `tiendas` NO es password_hash, es
# `hash('sha256', md5(sha1($clave)))` (lo replica `Account::signature()`).
# -----------------------------------------------------------------------------
# Con false, /registro solo informa de que el alta esta cerrada.
IDIRECTO_REGISTER=true
# Plan (code de `mt_plans`) con el que nace la tienda registrada.
IDIRECTO_REGISTER_PLAN=basico
# Intentos de registro por sesion antes de bloquear, y su ventana en segundos.
IDIRECTO_REGISTER_ATTEMPTS=5
IDIRECTO_REGISTER_WINDOW=900

# -----------------------------------------------------------------------------
# NAVEGACION: Menú Compacto y Menú Catalogo
#
# La tienda elige UNO de los dos estilos desde el panel (Panel > Menu). Los dos
# pintan exactamente el mismo arbol de categorias (mt_menu_items), que se copia
# una vez del menu de la web de referencia (PuntoByZE) y despues se edita en el
# panel. No hay ni habra un tercer estilo.
#
# Valores por defecto; solo hay que tocarlos si se quiere cambiar el arranque.
# -----------------------------------------------------------------------------
# Estilo con el que nace una tienda nueva: catalogo | compacto.
MENU_DEFAULT_STYLE=catalogo
# Categorias que caben en la barra del Menú Compacto; el resto va a «Mas categorias».
MENU_COMPACT_MAX=7
# Bloque promocional del panel (banner, marcas y productos destacados).
MENU_PANEL_PRODUCTS=3
MENU_PANEL_BRANDS=6
MENU_PANEL_BANNER=true
# Segundos de cache del arbol de menu (se invalida solo al guardar).
MENU_CACHE_TTL=900

# -----------------------------------------------------------------------------
# REGISTRO DE ACTIVIDAD (logs) POR DIA Y POR TIENDA
#
# Todo lo relevante (sobre todo las COMPRAS: carrito, checkout, pedido y envio a
# idirecto) se anota en ficheros para poder revisarlo si algo falla:
#
#   storage/logs/<canal>/<AAAA-MM-DD>/<id-tienda>_<slug>.log
#   storage/logs/compras/2026-10-08/1_idirecto-demo.log
#
# Una linea = un evento JSON (con nivel, mensaje, tienda, peticion e IP), asi que
# tambien se puede leer con `tail`, `grep` o `jq`. NO se guarda en la base de
# datos a proposito: el log no debe depender de lo que intenta diagnosticar.
#
# Se revisan desde el panel (Panel > Logs: cada tienda ve solo lo suyo; el rol
# `platform` ve todas) y por consola con `php tools/logs.php` (--ayuda).
#
# Las contrasenas, tokens y demas secretos se sustituyen por `***`.
# -----------------------------------------------------------------------------
# Interruptor general y nivel minimo: debug|info|notice|warning|error|critical.
LOG_ENABLED=true
LOG_LEVEL=info
# Dias que se conservan; la limpieza la lanza el panel, la consola y el propio log.
LOG_RETENTION_DAYS=30
# Carpeta raiz (por defecto, storage/logs).
LOG_PATH=
# Segundos entre limpiezas automaticas.
LOG_GC_INTERVAL=86400

