# Entorno y credenciales
.env
*.env
!*.env.example

# Dependencias
/vendor/

# Subidas locales (cuando STORAGE_DRIVER=local)
/public/uploads/*
!/public/uploads/.gitkeep

# Cache y logs
/storage/*
/storage/logs/*
!/storage/cache/.gitkeep
!/storage/logs/.gitkeep

# Contratos privados: las plantillas aprobadas si se versionan; los PDF
# individuales generados y el buzon falso nunca entran en git.
!/storage/contracts/
!/storage/contracts/.htaccess
!/storage/contracts/templates/
!/storage/contracts/templates/Contrato_web_clientes_v1.pdf
!/storage/contracts/templates/Contrato_web_clientes_v1.html
/storage/contracts/generated/*
!/storage/contracts/generated/.gitkeep
!/storage/contracts/generated/.htaccess
/storage/contracts/outbox/*
!/storage/contracts/outbox/.htaccess

# Sistema
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
nbproject/
*.swp

# Pruebas locales: se versionan las del alta, la portada y su doble de correo.
/tests/*
!/tests/registration_flow.php
!/tests/platform_landing.php
!/tests/Support/
!/tests/Support/FakeEmailApiClient.php
